{
  "entities": {
    "AuditRecord": {
      "title": "AuditRecord",
      "description": "Represents a growth audit generated by users.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "workspaceId": { "type": "string" },
        "userId": { "type": "string" },
        "status": { "type": "string", "enum": ["queued", "running", "partial", "completed", "failed"] },
        "mode": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "workspaceId", "status", "mode", "createdAt", "updatedAt"]
    }
  },
  "firestore": {
    "/audits/{auditId}": {
      "schema": "AuditRecord",
      "description": "Collection of growth audits generated by users."
    }
  }
}
